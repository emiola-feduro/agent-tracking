{
  "name": "agent-tracking",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "bun --watch packages/server/src/index.ts",
    "dev:web": "cd apps/web && bun run dev",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:web": "cd apps/web && bun run build",
    "start": "bun packages/server/src/index.ts",
    "check:web": "cd apps/web && bun run check"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/bun": "latest"
  }
}